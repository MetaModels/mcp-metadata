{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://metamodels.github.io/mcp-metadata/schema/1/metadata.schema.json",
    "title": "MetaModels MCP metadata",
    "description": "Facts about MetaModels packages, their attribute and filter types and the pages of the handbook. Data only, no instructions.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "handbook",
        "packages",
        "types",
        "articles"
    ],
    "properties": {
        "schema": {
            "const": 1,
            "description": "Format version. A reader that does not know the number ignores the file."
        },
        "generated": {
            "type": "string",
            "format": "date-time"
        },
        "packages": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/package"
            }
        },
        "types": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/type"
            }
        },
        "articles": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/article"
            }
        },
        "handbook": {
            "$ref": "#/$defs/handbook"
        }
    },
    "$defs": {
        "handbook": {
            "description": "Where the handbook is, per language. Pages have the same path in every language, so pages are named by path (docs, articles) and only the base address differs.",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "base_language",
                "urls"
            ],
            "properties": {
                "base_language": {
                    "type": "string",
                    "pattern": "^[a-z]{2}$",
                    "description": "The language the handbook is written in first and translated from. Must be a key of urls."
                },
                "urls": {
                    "type": "object",
                    "minProperties": 1,
                    "propertyNames": {
                        "pattern": "^[a-z]{2}$"
                    },
                    "additionalProperties": {
                        "type": "string",
                        "pattern": "^https://.*/$",
                        "maxLength": 300
                    }
                }
            }
        },
        "path": {
            "description": "Path of a page inside the handbook, without a leading slash, with an optional anchor.",
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_./-]{0,198}(#[a-z0-9_-]{1,80})?$",
            "not": {
                "pattern": "\\.\\."
            }
        },
        "text": {
            "description": "Short plain text by language code, English is required. No markup, no instructions.",
            "type": "object",
            "required": [
                "en"
            ],
            "propertyNames": {
                "pattern": "^[a-z]{2}$"
            },
            "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^[^<>]*$"
            }
        },
        "url": {
            "description": "Link by language code, English is required.",
            "type": "object",
            "required": [
                "en"
            ],
            "propertyNames": {
                "pattern": "^[a-z]{2}$"
            },
            "additionalProperties": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://",
                "maxLength": 300
            }
        },
        "keywords": {
            "description": "Search words by language code, English is required. One list per language because a word can mean different things in different languages.",
            "type": "object",
            "required": [
                "en"
            ],
            "propertyNames": {
                "pattern": "^[a-z]{2}$"
            },
            "additionalProperties": {
                "type": "array",
                "maxItems": 12,
                "uniqueItems": true,
                "items": {
                    "type": "string",
                    "pattern": "^[^<>\\n]{2,40}$"
                }
            }
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+){0,2}$"
        },
        "constraints": {
            "description": "Package name => version constraint. The name is a Composer package, or php.",
            "type": "object",
            "propertyNames": {
                "pattern": "^(php|[a-z0-9_.-]+/[a-z0-9_.-]+)$"
            },
            "additionalProperties": {
                "type": "string",
                "maxLength": 60
            }
        },
        "typeRef": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind",
                "type"
            ],
            "properties": {
                "kind": {
                    "enum": [
                        "attribute",
                        "filter"
                    ]
                },
                "type": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$"
                }
            }
        },
        "package": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "name",
                "availability"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+$"
                },
                "summary": {
                    "$ref": "#/$defs/text"
                },
                "keywords": {
                    "$ref": "#/$defs/keywords"
                },
                "availability": {
                    "description": "public: composer require works for everybody. early-access: only for supporters, see access. planned: does not exist yet. unknown: not stated, used by generated skeletons.",
                    "enum": [
                        "public",
                        "early-access",
                        "planned",
                        "unknown"
                    ]
                },
                "access": {
                    "description": "How to get a package that is not public. A page for humans, never credentials: either a page of the handbook (page) or an external address (url).",
                    "type": "object",
                    "additionalProperties": false,
                    "oneOf": [
                        {
                            "required": [
                                "url"
                            ]
                        },
                        {
                            "required": [
                                "page"
                            ]
                        }
                    ],
                    "properties": {
                        "url": {
                            "$ref": "#/$defs/url"
                        },
                        "page": {
                            "$ref": "#/$defs/path",
                            "description": "Page of the handbook, the address per language is built from handbook.urls."
                        },
                        "repository": {
                            "type": "string",
                            "format": "uri",
                            "pattern": "^https://",
                            "description": "Public URL of the Composer repository, if it is meant to be shown."
                        }
                    }
                },
                "plans": {
                    "description": "The supporter plans that include the package: basic-1 is the reduced plan for small projects, eap is the full Early Adopter Program. Left out if the package has a fundraising of its own, see access.",
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "enum": [
                            "basic-1",
                            "eap"
                        ]
                    }
                },
                "since": {
                    "$ref": "#/$defs/version",
                    "description": "First release of the package."
                },
                "requires": {
                    "$ref": "#/$defs/constraints",
                    "description": "What the current release needs, for example metamodels/core and contao/core-bundle."
                },
                "docs": {
                    "$ref": "#/$defs/path"
                },
                "conflicts": {
                    "$ref": "#/$defs/constraints",
                    "description": "Packages that must not be installed together with this one (the \"conflict\" of composer.json)."
                },
                "lines": {
                    "description": "The release lines of MetaModels the package exists for, with what each needs. A package that is not listed for a line does not exist there.",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/line"
                    }
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "availability": {
                                "const": "early-access"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "access"
                        ]
                    }
                }
            ]
        },
        "type": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "kind",
                "type",
                "package"
            ],
            "properties": {
                "kind": {
                    "enum": [
                        "attribute",
                        "filter"
                    ]
                },
                "type": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$",
                    "description": "The type name as the factory registers it."
                },
                "package": {
                    "type": "string",
                    "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+$",
                    "description": "Must name an entry of packages."
                },
                "summary": {
                    "$ref": "#/$defs/text"
                },
                "keywords": {
                    "$ref": "#/$defs/keywords"
                },
                "since": {
                    "$ref": "#/$defs/version",
                    "description": "First version of the package that has the type."
                },
                "docs": {
                    "$ref": "#/$defs/path"
                },
                "features": {
                    "description": "Abilities that came later than the type itself.",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "id",
                            "since",
                            "summary"
                        ],
                        "properties": {
                            "id": {
                                "type": "string",
                                "pattern": "^[a-z0-9_]+$",
                                "description": "Normally the name of the setting."
                            },
                            "since": {
                                "$ref": "#/$defs/version"
                            },
                            "summary": {
                                "$ref": "#/$defs/text"
                            }
                        }
                    }
                },
                "deprecated": {
                    "type": "boolean"
                },
                "replaced_by": {
                    "$ref": "#/$defs/typeRef"
                },
                "capabilities": {
                    "$ref": "#/$defs/capabilities",
                    "description": "Of the type in every release line of the package: the lines of the 2.x branch only add to it (semantic versioning). What differs for one line is stated in lines."
                },
                "works_with": {
                    "$ref": "#/$defs/worksWith",
                    "description": "Of the type in every release line of the package: the lines of the 2.x branch only add to it (semantic versioning). What differs for one line is stated in lines."
                },
                "lines": {
                    "description": "What differs for an older release line of MetaModels from the values of the type, for example the version of the packages for the frontend editing. An entry replaces capabilities or works_with of the type for that line as a whole. A line that is not listed has the values of the type.",
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "metamodels"
                        ],
                        "properties": {
                            "metamodels": {
                                "type": "string",
                                "pattern": "^\\d+\\.\\d+$",
                                "description": "The release line, for example 2.5. Must be a line of the package, not its newest."
                            },
                            "capabilities": {
                                "$ref": "#/$defs/capabilities"
                            },
                            "works_with": {
                                "$ref": "#/$defs/worksWith"
                            }
                        },
                        "anyOf": [
                            {
                                "required": [
                                    "capabilities"
                                ]
                            },
                            {
                                "required": [
                                    "works_with"
                                ]
                            }
                        ]
                    }
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "filter"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "not": {
                            "required": [
                                "capabilities"
                            ]
                        },
                        "properties": {
                            "lines": {
                                "items": {
                                    "not": {
                                        "required": [
                                            "capabilities"
                                        ]
                                    }
                                }
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "kind": {
                                "const": "attribute"
                            }
                        },
                        "required": [
                            "kind"
                        ]
                    },
                    "then": {
                        "not": {
                            "required": [
                                "works_with"
                            ]
                        },
                        "properties": {
                            "lines": {
                                "items": {
                                    "not": {
                                        "required": [
                                            "works_with"
                                        ]
                                    }
                                }
                            }
                        }
                    }
                }
            ]
        },
        "article": {
            "description": "A page of the handbook about a topic (kind topic, a page of the manual such as relations or several languages) or about a task (kind recipe, a page of the cookbook). Only a pointer, the text stays in the handbook.",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "kind",
                "title",
                "path"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "kind": {
                    "enum": [
                        "topic",
                        "recipe"
                    ]
                },
                "title": {
                    "$ref": "#/$defs/text"
                },
                "path": {
                    "$ref": "#/$defs/path"
                },
                "keywords": {
                    "$ref": "#/$defs/keywords"
                },
                "types": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/typeRef"
                    },
                    "description": "Types the page is about."
                },
                "requires": {
                    "$ref": "#/$defs/constraints"
                }
            }
        },
        "capabilities": {
            "description": "What an attribute can do, for planning. Values come from the code of the attribute and from the handbook page on data in attributes.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "multilingual": {
                    "type": "boolean",
                    "description": "True for the translated variants: one value per language, stored in a language table. Select and tags follow the language of a multilingual MetaModel by themselves and are not marked."
                },
                "multiple": {
                    "type": "boolean",
                    "description": "Can hold several values per item (possibly by a setting, such as several files)."
                },
                "datasources": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "enum": [
                            "metamodel",
                            "table",
                            "file",
                            "fixed"
                        ]
                    },
                    "description": "Where the values come from: another MetaModel, a Contao table, the file manager or a fixed list (countries, languages). Left out when the user types the value."
                },
                "file_usage": {
                    "type": "boolean",
                    "description": "The attribute shows up in the file usage list of Contao."
                },
                "frontend_editing": {
                    "$ref": "#/$defs/frontendEditing"
                }
            }
        },
        "frontendEditing": {
            "description": "Whether members can edit the attribute in the frontend (metamodels/contao-frontend-editing).",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "support"
            ],
            "properties": {
                "support": {
                    "enum": [
                        "yes",
                        "extra-package",
                        "no"
                    ],
                    "description": "extra-package: works only when the packages of requires are installed as well."
                },
                "requires": {
                    "$ref": "#/$defs/constraints",
                    "description": "Packages needed in addition when support is extra-package."
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "support": {
                                "const": "extra-package"
                            }
                        },
                        "required": [
                            "support"
                        ]
                    },
                    "then": {
                        "required": [
                            "requires"
                        ]
                    }
                }
            ]
        },
        "worksWith": {
            "description": "Which attributes a filter rule can be applied to.",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "attribute_types"
            ],
            "properties": {
                "attribute_types": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9_]+$"
                    },
                    "description": "Names of attribute types. Must be types of kind attribute."
                },
                "attribute_count": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "min": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "max": {
                            "type": "integer",
                            "minimum": 1
                        }
                    },
                    "description": "How many attributes the rule takes, for example 2 for a range between two attributes."
                }
            }
        },
        "line": {
            "description": "What one release line of MetaModels needs from the package (taken from the composer.json of that line).",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "metamodels",
                "requires"
            ],
            "properties": {
                "metamodels": {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+$",
                    "description": "The release line of MetaModels, for example 2.4."
                },
                "availability": {
                    "enum": [
                        "public",
                        "early-access",
                        "planned",
                        "unknown"
                    ],
                    "description": "How to get the package for this line. Left out when it is not stated; the availability of the package itself is the one of the newest line."
                },
                "requires": {
                    "$ref": "#/$defs/constraints",
                    "description": "What this line needs: php, contao/core-bundle, metamodels/* and contao-community-alliance/*."
                }
            }
        }
    }
}
