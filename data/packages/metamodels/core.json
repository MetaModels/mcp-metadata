{
    "name": "metamodels/core",
    "availability": "public",
    "lines": [
        {
            "metamodels": "2.4",
            "availability": "public",
            "requires": {
                "contao-community-alliance/dc-general": "^2.4.13",
                "contao-community-alliance/events-contao-bindings": "^5.0",
                "contao-community-alliance/meta-palettes": "^2.0.10",
                "contao-community-alliance/translator": "^2.5",
                "contao-community-alliance/url-builder": "^2.0",
                "contao/core-bundle": "^5.3 <5.7",
                "php": "^8.2"
            }
        },
        {
            "metamodels": "2.5",
            "availability": "public",
            "requires": {
                "contao-community-alliance/dc-general": "^2.5@dev",
                "contao-community-alliance/events-contao-bindings": "^5.7",
                "contao-community-alliance/meta-palettes": "^2.1",
                "contao-community-alliance/translator": "^2.6",
                "contao-community-alliance/url-builder": "^2.1",
                "contao/core-bundle": "^5.7",
                "php": "^8.4"
            }
        },
        {
            "metamodels": "2.6",
            "requires": {
                "contao-community-alliance/dc-general": "^2.6@dev",
                "contao-community-alliance/events-contao-bindings": "^6.0@dev",
                "contao-community-alliance/meta-palettes": "^2.2@dev",
                "contao-community-alliance/translator": "^2.7@dev",
                "contao-community-alliance/url-builder": "^2.2@dev",
                "contao/core-bundle": "^6.1",
                "php": "^8.4"
            }
        }
    ],
    "types": [
        {
            "kind": "filter",
            "type": "conditionand",
            "summary": {
                "en": "Container: an item has to match all rules inside."
            },
            "keywords": {
                "en": [
                    "and",
                    "combine",
                    "group"
                ],
                "de": [
                    "und",
                    "verknüpfen",
                    "gruppe"
                ]
            },
            "docs": "manual/component/filter/condition-and.html"
        },
        {
            "kind": "filter",
            "type": "conditionor",
            "summary": {
                "en": "Container: an item has to match at least one rule inside."
            },
            "keywords": {
                "en": [
                    "or",
                    "alternative"
                ],
                "de": [
                    "oder"
                ]
            },
            "docs": "manual/component/filter/condition-or.html"
        },
        {
            "kind": "filter",
            "type": "customsql",
            "summary": {
                "en": "Filters with your own SQL query that returns item ids."
            },
            "keywords": {
                "en": [
                    "sql",
                    "query"
                ],
                "de": [
                    "sql",
                    "abfrage"
                ]
            },
            "docs": "manual/component/filter/customsql.html"
        },
        {
            "kind": "filter",
            "type": "expression_rule",
            "summary": {
                "en": "Runs further rules only if a condition is met."
            },
            "keywords": {
                "en": [
                    "condition",
                    "expression",
                    "if"
                ],
                "de": [
                    "bedingung"
                ]
            },
            "docs": "manual/component/filter/expression-rule.html"
        },
        {
            "kind": "filter",
            "type": "idlist",
            "summary": {
                "en": "Fixed list of item ids as the basis of the filter."
            },
            "keywords": {
                "en": [
                    "ids",
                    "fixed"
                ],
                "de": [
                    "ids",
                    "festlegen",
                    "vordefiniert"
                ]
            },
            "docs": "manual/component/filter/idlist.html"
        },
        {
            "kind": "filter",
            "type": "simplelookup",
            "summary": {
                "en": "Filters by the value of one attribute, taken from the URL or fixed. The usual rule for detail pages."
            },
            "keywords": {
                "en": [
                    "detail",
                    "alias",
                    "url parameter",
                    "lookup",
                    "parameter",
                    "id"
                ],
                "de": [
                    "alias",
                    "einzelansicht",
                    "parameter",
                    "id"
                ]
            },
            "docs": "manual/component/filter/simplelookup.html",
            "works_with": {
                "attribute_types": [
                    "alias",
                    "combinedvalues",
                    "text",
                    "token",
                    "translatedalias",
                    "translatedcombinedvalues",
                    "translatedtext"
                ]
            }
        }
    ]
}
