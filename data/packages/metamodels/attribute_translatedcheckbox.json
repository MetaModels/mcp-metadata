{
    "name": "metamodels/attribute_translatedcheckbox",
    "availability": "early-access",
    "access": {
        "url": {
            "en": "https://now.metamodel.me/en/supporters/fundraising",
            "de": "https://now.metamodel.me/de/unterstuetzer/fundraising"
        }
    },
    "plans": [
        "eap"
    ],
    "lines": [
        {
            "metamodels": "2.4",
            "requires": {
                "contao-community-alliance/dc-general": "^2.4",
                "contao/core-bundle": "^5.3 <5.7",
                "metamodels/core": "^2.4",
                "php": "^8.2"
            }
        },
        {
            "metamodels": "2.5",
            "requires": {
                "contao-community-alliance/dc-general": "^2.5",
                "contao/core-bundle": "^5.7",
                "metamodels/core": "^2.5",
                "php": "^8.4"
            }
        },
        {
            "metamodels": "2.6",
            "requires": {
                "contao-community-alliance/dc-general": "^2.6@dev",
                "contao/core-bundle": "^6.0",
                "metamodels/core": "^2.6@dev",
                "php": "^8.4"
            }
        }
    ],
    "types": [
        {
            "kind": "attribute",
            "type": "translatedcheckbox",
            "summary": {
                "en": "Multilingual variant: yes/no value, for example published or featured."
            },
            "keywords": {
                "en": [
                    "boolean",
                    "yes no",
                    "published",
                    "multilingual",
                    "translated"
                ],
                "de": [
                    "boolean",
                    "ja nein",
                    "veröffentlicht",
                    "aktiv",
                    "häkchen",
                    "mehrsprachig",
                    "übersetzt"
                ]
            },
            "docs": "manual/component/attribute/translatedcheckbox.html",
            "capabilities": {
                "multilingual": true,
                "multiple": false,
                "file_usage": false,
                "frontend_editing": {
                    "support": "yes"
                }
            }
        },
        {
            "kind": "filter",
            "type": "translatedcheckbox_published",
            "summary": {
                "en": "Fixed filter like the checkbox status, for a translated checkbox. Has no frontend widget."
            },
            "keywords": {
                "en": [
                    "published",
                    "fixed",
                    "multilingual"
                ],
                "de": [
                    "veröffentlicht",
                    "fest",
                    "aktiv",
                    "mehrsprachig"
                ]
            },
            "docs": "manual/component/filter/translated-checkbox.html",
            "works_with": {
                "attribute_types": [
                    "translatedcheckbox"
                ]
            }
        }
    ]
}
