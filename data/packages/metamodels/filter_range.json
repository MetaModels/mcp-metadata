{
    "name": "metamodels/filter_range",
    "availability": "early-access",
    "access": {
        "url": {
            "en": "https://now.metamodel.me/en/supporters/fundraising",
            "de": "https://now.metamodel.me/de/unterstuetzer/fundraising"
        }
    },
    "plans": [
        "eap"
    ],
    "lines": [
        {
            "metamodels": "2.4",
            "requires": {
                "contao-community-alliance/dc-general": "^2.4",
                "contao/core-bundle": "^5.3 <5.7",
                "metamodels/core": "^2.4",
                "php": "^8.2"
            }
        },
        {
            "metamodels": "2.5",
            "requires": {
                "contao-community-alliance/dc-general": "^2.5",
                "contao/core-bundle": "^5.7",
                "metamodels/core": "^2.5",
                "php": "^8.4"
            }
        },
        {
            "metamodels": "2.6",
            "requires": {
                "contao-community-alliance/dc-general": "^2.6@dev",
                "contao/core-bundle": "^6.0",
                "metamodels/core": "^2.6@dev",
                "php": "^8.4"
            }
        }
    ],
    "types": [
        {
            "kind": "filter",
            "type": "range",
            "summary": {
                "en": "Visitor value lies between two attributes (start and end)."
            },
            "keywords": {
                "en": [
                    "range",
                    "between",
                    "overlap",
                    "period"
                ],
                "de": [
                    "zeitraum",
                    "von bis",
                    "laufzeit"
                ]
            },
            "docs": "manual/component/filter/range.html",
            "works_with": {
                "attribute_types": [
                    "decimal",
                    "numeric"
                ],
                "attribute_count": {
                    "min": 2,
                    "max": 2
                }
            }
        },
        {
            "kind": "filter",
            "type": "rangedate",
            "summary": {
                "en": "Visitor date lies between two date attributes, for example events with a start and an end."
            },
            "keywords": {
                "en": [
                    "period",
                    "event",
                    "start"
                ],
                "de": [
                    "zeitraum",
                    "event",
                    "termin",
                    "start",
                    "ende"
                ]
            },
            "docs": "manual/component/filter/range-date.html",
            "works_with": {
                "attribute_types": [
                    "timestamp"
                ],
                "attribute_count": {
                    "min": 2,
                    "max": 2
                }
            }
        }
    ]
}
