{
    "name": "metamodels/attribute_checkbox",
    "availability": "early-access",
    "access": {
        "url": {
            "en": "https://now.metamodel.me/en/supporters/fundraising",
            "de": "https://now.metamodel.me/de/unterstuetzer/fundraising"
        }
    },
    "plans": [
        "basic-1",
        "eap"
    ],
    "lines": [
        {
            "metamodels": "2.4",
            "availability": "early-access",
            "requires": {
                "contao-community-alliance/dc-general": "^2.4@dev",
                "contao/core-bundle": "^5.3 <5.7",
                "metamodels/core": "^2.4@dev",
                "php": "^8.2"
            }
        },
        {
            "metamodels": "2.5",
            "availability": "early-access",
            "requires": {
                "contao-community-alliance/dc-general": "^2.5",
                "contao/core-bundle": "^5.7",
                "metamodels/core": "^2.5",
                "php": "^8.4"
            }
        },
        {
            "metamodels": "2.6",
            "requires": {
                "contao-community-alliance/dc-general": "^2.6@dev",
                "contao/core-bundle": "^6.0",
                "metamodels/core": "^2.6@dev",
                "php": "^8.4"
            }
        }
    ],
    "types": [
        {
            "kind": "attribute",
            "type": "checkbox",
            "summary": {
                "en": "Yes/no value, for example published or featured."
            },
            "keywords": {
                "en": [
                    "boolean",
                    "yes no",
                    "published"
                ],
                "de": [
                    "boolean",
                    "ja nein",
                    "veröffentlicht",
                    "aktiv",
                    "häkchen"
                ]
            },
            "docs": "manual/component/attribute/checkbox.html",
            "capabilities": {
                "multilingual": false,
                "multiple": false,
                "file_usage": false,
                "frontend_editing": {
                    "support": "yes"
                }
            }
        },
        {
            "kind": "filter",
            "type": "checkbox_published",
            "summary": {
                "en": "Fixed filter: shows only items whose checkbox is set (formerly called \"published\"). Has no frontend widget."
            },
            "keywords": {
                "en": [
                    "published",
                    "fixed",
                    "status",
                    "publish"
                ],
                "de": [
                    "veröffentlicht",
                    "fest",
                    "aktiv",
                    "status"
                ]
            },
            "docs": "manual/component/filter/checkbox.html",
            "works_with": {
                "attribute_types": [
                    "checkbox"
                ]
            }
        }
    ]
}
