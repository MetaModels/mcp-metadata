{
    "name": "metamodels/attribute_select",
    "availability": "early-access",
    "access": {
        "url": {
            "en": "https://now.metamodel.me/en/supporters/fundraising",
            "de": "https://now.metamodel.me/de/unterstuetzer/fundraising"
        }
    },
    "plans": [
        "eap"
    ],
    "lines": [
        {
            "metamodels": "2.4",
            "availability": "early-access",
            "requires": {
                "contao-community-alliance/dc-general": "^2.4",
                "contao/core-bundle": "^5.3 <5.7",
                "metamodels/core": "^2.4",
                "php": "^8.2"
            }
        },
        {
            "metamodels": "2.5",
            "availability": "early-access",
            "requires": {
                "contao-community-alliance/dc-general": "^2.5",
                "contao/core-bundle": "^5.7",
                "metamodels/core": "^2.5",
                "php": "^8.4"
            }
        },
        {
            "metamodels": "2.6",
            "requires": {
                "contao-community-alliance/dc-general": "^2.6@dev",
                "contao/core-bundle": "^6.0",
                "metamodels/core": "^2.6@dev",
                "php": "^8.4"
            }
        }
    ],
    "types": [
        {
            "kind": "attribute",
            "type": "select",
            "summary": {
                "en": "Single choice from another MetaModel or a Contao table (1:n relation). Works in multilingual MetaModels too and follows the language by itself."
            },
            "keywords": {
                "en": [
                    "relation",
                    "category",
                    "dropdown",
                    "reference",
                    "1:n"
                ],
                "de": [
                    "relationen",
                    "kategorie",
                    "dropdown",
                    "auswahl",
                    "verknüpfung",
                    "1:n"
                ]
            },
            "docs": "manual/component/attribute/select.html",
            "capabilities": {
                "multilingual": false,
                "multiple": false,
                "datasources": [
                    "metamodel",
                    "table"
                ],
                "file_usage": false,
                "frontend_editing": {
                    "support": "yes"
                }
            }
        }
    ]
}
