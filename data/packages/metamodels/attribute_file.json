            }
        },
        {
            "metamodels": "2.5",
            "availability": "early-access",
            "requires": {
                "contao-community-alliance/dc-general": "^2.5",
                "contao/core-bundle": "^5.7",
                "metamodels/core": "^2.5",
                "php": "^8.4"
            }
        },
        {
            "metamodels": "2.6",
            "requires": {
                "contao-community-alliance/dc-general": "^2.6@dev",
                "contao/core-bundle": "^6.0",
                "metamodels/core": "^2.6@dev",
                "php": "^8.4"
            }
